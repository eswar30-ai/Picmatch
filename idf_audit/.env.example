# IDF audit service settings. Copy to .env and adjust; .env is never committed.

# Who may call. Open: anyone who reaches this host may submit audits and read
# verdicts. Otherwise callers send one of IDF_AUDIT_API_KEYS as X-API-Key.
OPEN_AUDIT_API=false
IDF_AUDIT_API_KEYS=

# IDF's server: evidence files the package gives only a path for are fetched from
# here (only the path is taken from the package; the host is always this one).
IDF_BASE_URL=http://192.168.214.23:4000

# Posting the verdict to their callback_url: off, they fetch it by GET. When on,
# always to IDF_CALLBACK_BASE with the package's path, with IDF_API_KEY as X-API-Key.
IDF_POST_CALLBACK=false
IDF_CALLBACK_BASE=http://192.168.214.23:4000
IDF_API_KEY=
IDF_CALLBACK_TIMEOUT=20

# The vision model.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5vl:7b
OLLAMA_TIMEOUT=180

# Only approved or rejected are answered. What the evidence can neither confirm
# nor contradict is approved at this score (0-100) or above, rejected below it.
APPROVE_SCORE=80

# Limits.
MAX_UPLOAD_SIZE_MB=50
UPLOAD_RATE_LIMIT_PER_MINUTE=10
MAX_QUEUED=100

# Where packages, files and verdicts are kept (default: var/ in this folder).
# IDF_DATA_DIR=
